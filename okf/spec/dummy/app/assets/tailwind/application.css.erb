@import "tailwindcss";

<%# Source paths composed by Partitia::Support from Rails + every registered plugin
    (Partitia::Support.plugins). Adding an engine to the plugin set makes its Tailwind
    classes scannable automatically — no hand-counted relative traversal. %>
<% raise "Partitia::Support.source_paths is empty — is the Rails env booted?" if Partitia::Support.source_paths.empty? %>
<% Partitia::Support.source_paths.each do |path| %>
@source "<%= path %>";
<% end %>
