source "https://rubygems.org"

# Specify your gem's dependencies in appwork-manager.gemspec.
gemspec

gem "puma"

gem "sqlite3"

gem "propshaft"

# Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
gem "rubocop-rails-omakase", require: false

# Start debugger with binding.b [https://github.com/ruby/debug]
# gem "debug", ">= 1.0.0"

group :development, :test do
  gem "factory_bot_rails"
  gem "rspec-rails"
end

group :development do
  gem "ruby-lsp-rspec", require: false
  gem "ruby-lsp-rails", require: false
end

# Partitia's engines, by gem name from gem-local's links (gem-local list); appwork's own
# gems from their sibling dirs
partitia_gems = ENV.fetch("RUBY_LOCAL_GEMS_HOME") { File.join(ENV.fetch("XDG_DATA_HOME") { File.join(Dir.home, ".local/share") }, "gems") }
gem "partitia-support", path: "#{partitia_gems}/partitia-support"
gem "partitia-dev", path: "#{partitia_gems}/partitia-dev"
gem "appwork-okf", path: "../okf"
gem "appwork-chorus", path: "../chorus"
