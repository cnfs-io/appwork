<%= form_with model: agent, class: "space-y-4" do |form| %>
  <% if agent.errors.any? %>
    <div class="rounded-md border border-danger bg-surface px-4 py-3 text-sm text-danger">
      <h2 class="font-medium"><%= t("chorus.errors_heading", count: agent.errors.count, default: "%{count} error(s) prohibited this from being saved") %></h2>
      <ul class="mt-2 list-disc list-inside">
        <% agent.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

    <div>
    <%= form.label :organization_id, Chorus::Agent.human_attribute_name(:organization), class: "block text-sm font-medium text-text-muted" %>
    <%= form.collection_select :organization_id, Chorus::Organization.order(:name), :id, :name, { include_blank: false }, class: "mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-text shadow-sm focus:border-primary focus:outline-none" %>
  </div>

    <div>
    <%= form.label :role_id, Chorus::Agent.human_attribute_name(:role), class: "block text-sm font-medium text-text-muted" %>
    <%= form.collection_select :role_id, Chorus::Role.order(:name), :id, :name, { include_blank: t("chorus.unassigned") }, class: "mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-text shadow-sm focus:border-primary focus:outline-none" %>
  </div>

    <div>
    <%= form.label :name, class: "block text-sm font-medium text-text-muted" %>
    <%= form.text_field :name, class: "mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-text shadow-sm focus:border-primary focus:outline-none" %>
  </div>

    <div>
    <%= form.label :kind, class: "block text-sm font-medium text-text-muted" %>
    <%= form.text_field :kind, class: "mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-text shadow-sm focus:border-primary focus:outline-none" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= form.submit t("chorus.actions.save"), class: "inline-flex items-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-contrast hover:opacity-90 cursor-pointer" %>
    <%= link_to t("chorus.actions.cancel"), agent.persisted? ? agent : agents_path, class: "text-sm font-medium text-primary hover:underline" %>
  </div>
<% end %>
