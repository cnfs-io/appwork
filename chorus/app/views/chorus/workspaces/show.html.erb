<% content_for :title, @workspace.name %>

<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-text"><%= @workspace.name %></h1>
    <div class="flex items-center gap-3">
      <%= link_to t("chorus.actions.edit"), edit_workspace_path(@workspace), class: "inline-flex items-center rounded-md border border-border bg-surface px-4 py-2 text-sm font-medium text-text hover:bg-surface-muted" %>
      <%= link_to t("chorus.actions.back"), workspaces_path, class: "text-sm font-medium text-primary hover:underline" %>
    </div>
  </div>

  <dl class="divide-y divide-border rounded-lg border border-border bg-surface">
    <div class="px-4 py-3">
      <dt class="text-xs font-semibold uppercase tracking-wide text-text-muted"><%= Chorus::Workspace.human_attribute_name(:name) %></dt>
      <dd class="mt-1 text-sm text-text"><%= @workspace.name %></dd>
    </div>
      <div class="px-4 py-3">
      <dt class="text-xs font-semibold uppercase tracking-wide text-text-muted"><%= Chorus::Workspace.human_attribute_name(:active_project) %></dt>
      <dd class="mt-1 text-sm text-text">
        <% if @workspace.active_project %>
          <%= link_to @workspace.active_project.name, @workspace.active_project, class: "text-primary hover:underline" %>
        <% else %>
          <%= t("chorus.unassigned") %>
        <% end %>
      </dd>
    </div>
      <div class="px-4 py-3">
      <dt class="text-xs font-semibold uppercase tracking-wide text-text-muted"><%= Chorus::Workspace.human_attribute_name(:description) %></dt>
      <dd class="mt-1 text-sm text-text"><%= @workspace.description %></dd>
    </div>
  </dl>

  <section class="space-y-2">
    <h2 class="text-lg font-semibold text-text"><%= Chorus::Artifact.model_name.human(count: 2) %></h2>
    <div class="overflow-hidden rounded-lg border border-border bg-surface">
      <ul class="divide-y divide-border">
        <% if @workspace.artifacts.any? %>
          <% @workspace.artifacts.order(:name).each do |artifact| %>
            <li class="flex items-center justify-between px-4 py-3 text-sm">
              <span class="text-text"><%= link_to artifact.name, artifact, class: "text-primary hover:underline" %></span>
              <span class="text-text-muted"><%= artifact.kind %></span>
            </li>
          <% end %>
        <% else %>
          <li class="px-4 py-3 text-sm text-text-muted"><%= t("chorus.empty", model: Chorus::Artifact.model_name.human(count: 2)) %></li>
        <% end %>
      </ul>
    </div>
  </section>

  <%= button_to t("chorus.actions.destroy"), @workspace, method: :delete,
        class: "inline-flex items-center rounded-md bg-danger px-3 py-1.5 text-sm font-medium text-danger-contrast hover:opacity-90",
        data: { turbo_confirm: t("chorus.confirm.destroy") } %>
</div>
