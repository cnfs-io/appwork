<tr id="<%= dom_id(workspace) %>" class="border-t border-border">
    <td class="px-4 py-2 text-sm text-text"><%= workspace.name %></td>
    <td class="px-4 py-2 text-sm text-text"><%= workspace.organization&.name %></td>
    <td class="px-4 py-2 text-sm text-text"><%= workspace.active_project&.name || t("chorus.unassigned") %></td>
    <td class="px-4 py-2 text-right text-sm whitespace-nowrap">
      <%= link_to t("chorus.actions.show"), workspace, class: "text-sm font-medium text-primary hover:underline" %>
      <%= link_to t("chorus.actions.edit"), edit_workspace_path(workspace), class: "text-sm font-medium text-primary hover:underline ml-3" %>
      <%= button_to t("chorus.actions.destroy"), workspace, method: :delete,
            form: { class: "inline ml-3" },
            class: "inline-flex items-center rounded-md bg-danger px-3 py-1.5 text-sm font-medium text-danger-contrast hover:opacity-90",
            data: { turbo_confirm: t("chorus.confirm.destroy") } %>
    </td>
  </tr>
