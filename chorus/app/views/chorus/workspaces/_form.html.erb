<%= form_with model: workspace, class: "space-y-4" do |form| %>
  <% if workspace.errors.any? %>
    <div class="rounded-md border border-danger bg-surface px-4 py-3 text-sm text-danger">
      <h2 class="font-medium"><%= t("chorus.errors_heading", count: workspace.errors.count, default: "%{count} error(s) prohibited this from being saved") %></h2>
      <ul class="mt-2 list-disc list-inside">
        <% workspace.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

    <div>
    <%= form.label :active_project_id, Chorus::Workspace.human_attribute_name(:active_project), class: "block text-sm font-medium text-text-muted" %>
    <%= form.collection_select :active_project_id, Chorus::Project.order(:name), :id, :name, { include_blank: t("chorus.unassigned") }, class: "mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-text shadow-sm focus:border-primary focus:outline-none" %>
  </div>

    <div>
    <%= form.label :name, class: "block text-sm font-medium text-text-muted" %>
    <%= form.text_field :name, class: "mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-text shadow-sm focus:border-primary focus:outline-none" %>
  </div>

    <div>
    <%= form.label :description, class: "block text-sm font-medium text-text-muted" %>
    <%= form.text_area :description, rows: 4, class: "mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-text shadow-sm focus:border-primary focus:outline-none" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= form.submit t("chorus.actions.save"), class: "inline-flex items-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-contrast hover:opacity-90 cursor-pointer" %>
    <%= link_to t("chorus.actions.cancel"), workspace.persisted? ? workspace : workspaces_path, class: "text-sm font-medium text-primary hover:underline" %>
  </div>
<% end %>
