<% content_for :title, t("chorus.actions.new_model", model: Chorus::Goal.model_name.human) %>

<div class="max-w-2xl space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-text"><%= t("chorus.actions.new_model", model: Chorus::Goal.model_name.human) %></h1>
    <%= link_to t("chorus.actions.back"), goals_path, class: "text-sm font-medium text-primary hover:underline" %>
  </div>

  <div class="rounded-lg border border-border bg-surface p-6">
    <%= render "form", goal: @goal %>
  </div>
</div>
