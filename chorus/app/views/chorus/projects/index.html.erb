<% content_for :title, Chorus::Project.model_name.human(count: 2) %>

<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-text"><%= Chorus::Project.model_name.human(count: 2) %></h1>
    <%= link_to t("chorus.actions.new_model", model: Chorus::Project.model_name.human), new_project_path, class: "inline-flex items-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-contrast hover:opacity-90" %>
  </div>

  <%= turbo_frame_tag "chorus_projects" do %>
    <div class="overflow-hidden rounded-lg border border-border bg-surface">
      <table class="min-w-full divide-y divide-border">
        <thead class="bg-surface-muted">
          <tr>
        <th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wide text-text-muted"><%= Chorus::Project.human_attribute_name(:name) %></th>
        <th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wide text-text-muted"><%= Chorus::Project.human_attribute_name(:status) %></th>
        <th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wide text-text-muted"><%= Chorus::Project.human_attribute_name(:goal) %></th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody id="chorus_projects_rows">
          <% if @projects.any? %>
            <%= render @projects %>
          <% else %>
            <tr>
              <td colspan="4" class="px-4 py-6 text-center text-sm text-text-muted">
                <%= t("chorus.empty", model: Chorus::Project.model_name.human(count: 2)) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
