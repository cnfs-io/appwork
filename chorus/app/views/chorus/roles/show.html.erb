<% content_for :title, @role.name %>

<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-text"><%= @role.name %></h1>
    <div class="flex items-center gap-3">
      <%= link_to t("chorus.actions.edit"), edit_role_path(@role), class: "inline-flex items-center rounded-md border border-border bg-surface px-4 py-2 text-sm font-medium text-text hover:bg-surface-muted" %>
      <%= link_to t("chorus.actions.back"), roles_path, class: "text-sm font-medium text-primary hover:underline" %>
    </div>
  </div>

  <dl class="divide-y divide-border rounded-lg border border-border bg-surface">
    <div class="px-4 py-3">
      <dt class="text-xs font-semibold uppercase tracking-wide text-text-muted"><%= Chorus::Role.human_attribute_name(:name) %></dt>
      <dd class="mt-1 text-sm text-text"><%= @role.name %></dd>
    </div>
      <div class="px-4 py-3">
      <dt class="text-xs font-semibold uppercase tracking-wide text-text-muted"><%= Chorus::Role.human_attribute_name(:organization) %></dt>
      <dd class="mt-1 text-sm text-text"><%= @role.organization&.name %></dd>
    </div>
      <div class="px-4 py-3">
      <dt class="text-xs font-semibold uppercase tracking-wide text-text-muted"><%= Chorus::Role.human_attribute_name(:description) %></dt>
      <dd class="mt-1 text-sm text-text"><%= @role.description %></dd>
    </div>
  </dl>

  <%= button_to t("chorus.actions.destroy"), @role, method: :delete,
        class: "inline-flex items-center rounded-md bg-danger px-3 py-1.5 text-sm font-medium text-danger-contrast hover:opacity-90",
        data: { turbo_confirm: t("chorus.confirm.destroy") } %>
</div>
