<tr id="<%= dom_id(role) %>" class="border-t border-border">
    <td class="px-4 py-2 text-sm text-text"><%= role.name %></td>
    <td class="px-4 py-2 text-right text-sm whitespace-nowrap">
      <%= link_to t("chorus.actions.show"), role, class: "text-sm font-medium text-primary hover:underline" %>
      <%= link_to t("chorus.actions.edit"), edit_role_path(role), class: "text-sm font-medium text-primary hover:underline ml-3" %>
      <%= button_to t("chorus.actions.destroy"), role, method: :delete,
            form: { class: "inline ml-3" },
            class: "inline-flex items-center rounded-md bg-danger px-3 py-1.5 text-sm font-medium text-danger-contrast hover:opacity-90",
            data: { turbo_confirm: t("chorus.confirm.destroy") } %>
    </td>
  </tr>
